{
  "name": "blackbox",
  "version": "2.0.0",
  "description": "BlackboardChina course-material downloader",
  "main": "dist/gui/main.js",
  "scripts": {
    "build": "node scripts/clean-dist.js && tsc -p tsconfig.gui.json",
    "build:gui": "node scripts/clean-dist.js && tsc -p tsconfig.gui.json && npm run typecheck:renderer && vite build --config vite.gui.config.ts && node scripts/copy-renderer-font-licenses.cjs",
    "build:app": "npm run build:gui && electron-builder --win nsis --x64",
    "build:unpacked": "npm run build:gui && electron-builder --win dir --x64",
    "gui": "electron dist/gui/main.js",
    "gui:dev": "npm run build && vite --config vite.gui.config.ts",
    "gui:demo": "npm run build && vite --config vite.gui.config.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json"
  },
  "author": {
    "name": "Gavania",
    "email": "jinling114@outlook.com"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "p-limit": "^3.1.0",
    "p-retry": "^4.6.2",
    "playwright-core": "^1.40.0",
    "sanitize-filename": "^1.6.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "build": {
    "appId": "com.panther114.blackbox",
    "productName": "Blackbox",
    "artifactName": "Blackbox-${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "assets/app-icon.png",
      "package.json",
      "node_modules/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.ts",
      "!node_modules/exceljs/dist/es5/**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/app-icon.png",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "publisherName": "Panther114"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Panther114",
        "repo": "blackbox",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  }
}
