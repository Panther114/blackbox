{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blackbox",
  "version": "2.0.0",
  "identifier": "com.panther114.blackbox",
  "build": {
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist/gui/renderer",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Blackbox",
        "width": 1120,
        "height": 760,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
